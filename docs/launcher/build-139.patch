 #include "gui/Gx.h"
-#include "splashTop.h"
+#include "splashQuickReturn.h"
+#include "splashVgm.h"
 #include "App.h"
 
 #define SPLASH_FRAMES       44
+#define VGM_SPLASH_FRAMES   53
+#define SPLASH_CROSSFADE_FRAMES 16
 
 App::App(IAppSettingsService& appSettingsService, IBgmService& bgmService)
     : _mainObjPltt(GFX_PLTT_OBJ_MAIN)
@@ -67,23 +70,69 @@ void App::InitVramMapping() const
 
 void App::DisplaySplashScreen() const
 {
-    dma_ntrCopy32(3, splashTopTiles, GFX_BG_SUB, splashTopTilesLen);
-    dma_ntrCopy32(3, splashTopMap, (u8*)GFX_BG_SUB + 0x3000, splashTopMapLen);
-    mem_setVramHMapping(MEM_VRAM_H_LCDC);
-    dma_ntrCopy32(3, splashTopPal, (void*)0x0689A000, splashTopPalLen);
-    mem_setVramHMapping(MEM_VRAM_H_SUB_BG_EXT_PLTT_SLOT_0123);
+    // Both splashes reside in VRAM C before theme graphics are uploaded.
+    static_assert(splashQuickReturnTilesLen <= 0xF000);
+    static_assert(splashVgmTilesLen <= 0x10000);
+    static_assert(splashQuickReturnMapLen <= 0x800);
+    static_assert(splashVgmMapLen <= 0x800);
+    static_assert(splashVgmPalLen == 512);
 
     VBlank::Wait();
+    REG_MASTER_BRIGHT_SUB = 0x4010;
+    dma_ntrCopy32(3, splashQuickReturnTiles, GFX_BG_SUB, splashQuickReturnTilesLen);
+    dma_ntrCopy32(3, splashQuickReturnMap, (u8*)GFX_BG_SUB + 0xF000, splashQuickReturnMapLen);
+    dma_ntrCopy32(3, splashVgmTiles, (u8*)GFX_BG_SUB + 0x10000, splashVgmTilesLen);
+    dma_ntrCopy32(3, splashVgmMap, (u8*)GFX_BG_SUB + 0xF800, splashVgmMapLen);
+
+    // The platform-converted VGM asset reserves index 255. Remap transparent
+    // index zero to that entry so the incoming screen is fully opaque.
+    vu32* incomingTiles = (vu32*)((u8*)GFX_BG_SUB + 0x10000);
+    for (u32 i = 0; i < splashVgmTilesLen / 4; i++)
+    {
+        u32 word = incomingTiles[i];
+        for (u32 shift = 0; shift < 32; shift += 8)
+            if (((word >> shift) & 255) == 0)
+                word |= 255u << shift;
+        incomingTiles[i] = word;
+    }
+
+    mem_setVramHMapping(MEM_VRAM_H_LCDC);
+    dma_ntrCopy32(3, splashQuickReturnPal, (void*)0x06898000, splashQuickReturnPalLen);
+    dma_ntrCopy32(3, splashVgmPal, (void*)0x0689A000, splashVgmPalLen);
+    ((vu16*)0x0689A000)[255] = splashVgmPal[0];
+    mem_setVramHMapping(MEM_VRAM_H_SUB_BG_EXT_PLTT_SLOT_0123);
 
     sys_setMainEngineToBottomScreen();
-    REG_DISPCNT_SUB = 0x40211015;
+    REG_DISPCNT_SUB = 0x40211015 | (1 << 8);
+    REG_BG0HOFS_SUB = 0;
+    REG_BG0VOFS_SUB = 0;
     REG_BG1HOFS_SUB = 0;
     REG_BG1VOFS_SUB = 0;
-    REG_BG1CNT_SUB = 0x0680;
-    REG_DISPCNT_SUB |= 1 << 9;
-    REG_BLDCNT_SUB = 0x3D42;
-    REG_BLDALPHA_SUB = 0x10;
+    REG_BG0CNT_SUB = 0x1E81; // QR: tile base 0, map 30, priority 1.
+    REG_BG1CNT_SUB = 0x1F90; // VGM: tile base 4, map 31, priority 0.
+    REG_BLDCNT_SUB = 0;
     REG_MASTER_BRIGHT_SUB = 0;
+    for (int i = 0; i < SPLASH_FRAMES; i++)
+        VBlank::Wait();
+
+    // Incoming BG1 is the first alpha target; outgoing BG0 is the second.
+    REG_BLDALPHA_SUB = 16 << 8;
+    REG_BLDCNT_SUB = 0x0142;
+    REG_DISPCNT_SUB |= 1 << 9;
+    for (int alpha = 1; alpha <= SPLASH_CROSSFADE_FRAMES; alpha++)
+    {
+        VBlank::Wait();
+        REG_BLDALPHA_SUB = ((16 - alpha) << 8) | alpha;
+    }
+    REG_DISPCNT_SUB &= ~(1 << 8);
+    REG_BLDCNT_SUB = 0;
+    for (int i = 0; i < VGM_SPLASH_FRAMES; i++)
+        VBlank::Wait();
+
+    VBlank::Wait();
+    REG_MASTER_BRIGHT_SUB = 0x4010;
+    REG_MASTER_BRIGHT = 0x4010;
+    REG_DISPCNT_SUB &= ~(1 << 9);
 }
 
 void App::LoadTheme()
@@ -195,7 +244,7 @@ void App::Run()
 void App::MainLoop()
 {
     bool fadeIn = true;
-    int fadeWaitFrames = SPLASH_FRAMES;
+    int fadeWaitFrames = 0;
     while (true)
     {
         Update();
@@ -229,12 +278,14 @@ void App::MainLoop()
                     REG_BLDCNT_SUB = 0;
                     REG_DISPCNT_SUB &= ~(1 << 9);
                     REG_MASTER_BRIGHT = 0;
+                    REG_MASTER_BRIGHT_SUB = 0;
                 }
                 else
                 {
                     int fade = _fadeAnimator.GetValue();
                     REG_BLDALPHA_SUB = ((16 - fade) << 8) | fade;
                     REG_MASTER_BRIGHT = 0x4000 | fade;
+                    REG_MASTER_BRIGHT_SUB = 0x4000 | fade;
                 }
             }
         }
